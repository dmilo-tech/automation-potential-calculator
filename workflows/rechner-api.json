    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\nconst probleme = [];\n\n// Hilfsfunktion: macht aus allem einen gesäuberten Text\nconst text = (wert) => String(wert ?? \"\").trim();\n\n// Honeypot: Menschen sehen dieses Feld nicht, Bots füllen es aus\nconst istBot = text(body.website) !== \"\";\n\nconst name = text(body.name);\nconst email = text(body.email).toLowerCase();\nconst bereich = text(body.bereich);\nconst aufgaben = text(body.aufgaben);\nconst stunden = Number(body.stunden);\nconst personen = Number(body.personen);\nconst stundensatz = Number(body.stundensatz);\n\nconst ERLAUBTE_BEREICHE = [\"vertrieb\", \"marketing\", \"kundenservice\", \"buchhaltung\", \"sonstiges\"];\n\n// Checkliste\nif (name.length < 2 || name.length > 100) {\n  probleme.push(\"Name: 2 bis 100 Zeichen\");\n}\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) {\n  probleme.push(\"E-Mail: ungültig\");\n}\nif (!ERLAUBTE_BEREICHE.includes(bereich)) {\n  probleme.push(\"Bereich: unbekannt\");\n}\nif (aufgaben.length < 10 || aufgaben.length > 1000) {\n  probleme.push(\"Aufgaben: 10 bis 1000 Zeichen\");\n}\nif (!Number.isFinite(stunden) || stunden < 1 || stunden > 40) {\n  probleme.push(\"Stunden: 1 bis 40\");\n}\nif (!Number.isInteger(personen) || personen < 1 || personen > 500) {\n  probleme.push(\"Personen: ganze Zahl von 1 bis 500\");\n}\nif (!Number.isFinite(stundensatz) || stundensatz < 10 || stundensatz > 300) {\n  probleme.push(\"Stundensatz: 10 bis 300\");\n}\nif (body.einwilligung !== \"on\") {\n  probleme.push(\"Einwilligung: fehlt\");\n}\n\nreturn [{\n  json: {\n    istBot,\n    gueltig: probleme.length === 0,\n    probleme,\n    lead: { name, email, bereich, aufgaben, stunden, personen, stundensatz },\n  },\n}];"
      },
