      ],
      "id": "dd6605ad-1acc-4645-887b-30d75989280c",
      "name": "KI: Ideen",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "credentials": {
        "openAiApi": {
          "id": "RQIFDQ9fBgqrW0rr",
          "name": "OpenAI account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// KI-Antwort lesen (kann Text oder schon ein Objekt sein)\nfunction parseLLMJson(roh) {\n  if (typeof roh === \"object\" && roh !== null) return roh;\n  try {\n    return JSON.parse(String(roh ?? \"\").replace(/```json|```/g, \"\").trim());\n  } catch (e) {\n    return null;\n  }\n}\n\nconst roh = $input.first().json.output?.[0]?.content?.[0]?.text;\nconst daten = parseLLMJson(roh);\nconst lead = $('Eingaben prüfen').first().json.lead;\n\nconst ERLAUBTER_AUFWAND = [\"niedrig\", \"mittel\", \"hoch\"];\nconst probleme = [];\n\nconst liste = Array.isArray(daten?.ideen) ? daten.ideen : [];\n\nif (liste.length !== 3) {\n  probleme.push(`Anzahl: ${liste.length} statt 3 Ideen`);\n}\n\n// Jede Idee einzeln prüfen und säubern\nconst ideen = liste.map((idee, i) => {\n  const titel = String(idee?.titel ?? \"\").trim();\n  const beschreibung = String(idee?.beschreibung ?? \"\").trim();\n  const werkzeuge = String(idee?.werkzeuge ?? \"\").trim();\n  const aufwand = String(idee?.aufwand ?? \"\").trim().toLowerCase();\n\n  if (titel.length < 3 || titel.length > 80) {\n    probleme.push(`Idee ${i + 1}: Titel fehlt oder zu lang`);\n  }\n  if (beschreibung.length < 20 || beschreibung.length > 300) {\n    probleme.push(`Idee ${i + 1}: Beschreibung fehlt oder zu lang`);\n  }\n  if (werkzeuge === \"\") {\n    probleme.push(`Idee ${i + 1}: Werkzeuge fehlen`);\n  }\n  if (!ERLAUBTER_AUFWAND.includes(aufwand)) {\n    probleme.push(`Idee ${i + 1}: Aufwand \"${aufwand}\" unbekannt`);\n  }\n\n  return { titel, beschreibung, werkzeuge, aufwand };\n});\n\nconst ideenOk = probleme.length === 0;\n\nreturn [{\n  json: {\n    ideenOk,\n    ideen: ideenOk ? ideen : [],\n    probleme,\n    lead,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        -208
      ],
      "id": "a0b09a7d-e49c-4650-8134-6d9349cfc40b",
      "name": "Ideen prüfen"
    },
    {
      "parameters": {
        "jsCode": "const { lead, ideen, ideenOk } = $('Ideen prüfen').first().json;\n\n// Gleiche Annahmen wie in app.js – bei Änderungen an BEIDEN Stellen anpassen!\nconst AUTOMATISIERUNGSGRAD = {\n  vertrieb: 0.4,\n  marketing: 0.5,\n  kundenservice: 0.5,\n  buchhaltung: 0.6,\n  sonstiges: 0.3,\n};\nconst ARBEITSWOCHEN_PRO_JAHR = 46;\n\nfunction berechnePotenzial({ stunden, personen, stundensatz, bereich }) {\n  const grad = AUTOMATISIERUNGSGRAD[bereich] ?? 0.3;\n  const stundenProJahr = stunden * personen * ARBEITSWOCHEN_PRO_JAHR;\n  const gesparteStunden = Math.round(stundenProJahr * grad);\n  const gesparteEuro = Math.round(gesparteStunden * stundensatz);\n  return { stundenProJahr, grad, gesparteStunden, gesparteEuro };\n}\n\nconst ergebnis = berechnePotenzial(lead);\n\n// Ideen als gut lesbaren Text für das Long-text-Feld\nconst ideenText = ideen\n  .map((idee, i) => `${i + 1}. ${idee.titel} (Aufwand: ${idee.aufwand})\\n${idee.beschreibung}\\nWerkzeuge: ${idee.werkzeuge}`)\n  .join(\"\\n\\n\");\n\nreturn [{\n  json: {\n    name: lead.name,\n    email: lead.email,\n    bereich: lead.bereich,\n    aufgaben: lead.aufgaben,\n    stunden: lead.stunden,\n    personen: lead.personen,\n    stundensatz: lead.stundensatz,\n    gesparteStunden: ergebnis.gesparteStunden,\n    gesparteEuro: ergebnis.gesparteEuro,\n    ideen: ideenOk ? ideenText : \"\",\n    ideenOk,\n    status: ideenOk ? \"neu\" : \"manuell prüfen\",\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
